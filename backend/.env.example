NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/urbanheat
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEATHER_CACHE_TTL_SECONDS=600
USE_MONGODB=false
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
OPENAQ_ENABLED=false
OPENAQ_API_KEY=
OPENAQ_RADIUS_METERS=15000
# NASA products are delayed satellite observations, not instantaneous measurements.
NASA_ENABLED=false
NASA_EARTHDATA_TOKEN=-at-least-32-characters
